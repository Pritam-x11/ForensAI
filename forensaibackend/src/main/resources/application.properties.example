spring.application.name=forensaibackend

spring.datasource.url=jdbc:mysql://localhost:3306/forensai_db?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=Asia/Kolkata
spring.datasource.username=YOUR_MYSQL_USERNAME
spring.datasource.password=YOUR_MYSQL_PASSWORD

spring.jpa.hibernate.ddl-auto=update

jwt.secret=YOUR_JWT_SECRET

ai.service.url=http://127.0.0.1:8000

spring.servlet.multipart.max-file-size=200MB
spring.servlet.multipart.max-request-size=200MB